---
import { Image } from 'astro:assets';
import { actosOrdenados, dias as getDias, maps, nombreDia, rangoLargo, type Agenda } from '../lib/agenda';

interface Props {
  agenda: Agenda;
  /** Enlace que se pone al final del mensaje copiado */
  shareUrl: string;
}

const { agenda, shareUrl } = Astro.props;
const { titulo, desde, hasta, permanentes } = agenda.data;
const ordenados = actosOrdenados(agenda);
const dias = getDias(agenda);
const enlace = shareUrl.replace(/^https?:\/\//, '');
---

<main class="mx-auto max-w-2xl px-5 pb-6 text-white">
  <header class="pt-8 pb-4">
    <a href="/links" class="text-sm text-[#979797] hover:text-white">← El Rincón del Papón</a>
    <h1 class="mt-3 text-4xl font-bold leading-tight">{titulo}</h1>
    <p class="mt-2 text-[#979797]">{rangoLargo(desde, hasta)} · León</p>
  </header>

  <nav class="sticky top-0 z-10 -mx-5 flex flex-wrap gap-2 border-b border-[#404040] bg-[#262626] px-5 py-3" aria-label="Días">
    <div class="flex flex-wrap gap-2" role="tablist">
      {dias.map((d, i) => (
        <button class="tab min-h-11 rounded-full border border-[#404040] px-4 font-semibold" role="tab" data-day={d} aria-selected={i === 0 ? 'true' : 'false'}>
          {nombreDia(d)}
          <span class="ml-1 text-sm font-normal opacity-70">{ordenados.filter((a) => a.d === d).length}</span>
        </button>
      ))}
    </div>
    <input
      id="q"
      type="search"
      placeholder="Buscar hermandad, templo, acto…"
      aria-label="Buscar"
      class="min-h-11 flex-1 basis-48 rounded-full border border-[#404040] bg-[#404040] px-4 text-base text-white placeholder:text-[#979797]"
    />
  </nav>

  {dias.map((d, i) => {
    const delDia = ordenados.filter((a) => a.d === d);
    const mensaje =
      `📅 ${nombreDia(d).toUpperCase()}\n\n` +
      delDia.map((a) => `${a.h} · ${a.t} · ${a.hdad} · ${a.lugar}`).join('\n') +
      (permanentes.length ? `\n\nTodo el finde:\n` + permanentes.map((p) => `${p.t} · ${p.lugar}`).join('\n') : '') +
      `\n\n👉 Agenda completa: ${enlace}`;
    return (
      <section class="day pt-5" data-day={d} id={d} hidden={i !== 0}>
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="text-2xl font-bold">{nombreDia(d)}</h2>
          <button class="copy min-h-11 rounded-full border border-[rgb(136,58,234)] px-4 text-sm font-semibold text-[rgb(224,204,250)]" data-msg={mensaje}>
            Copiar mensaje del día
          </button>
        </div>

        {permanentes.length > 0 && (
          <div class="mt-3 rounded-xl border border-[#404040] p-4">
            <p class="text-sm font-semibold text-[rgb(224,204,250)]">Todos los días</p>
            {permanentes.map((p) => (
              <div class="ev mt-2" data-text={[p.t, p.hdad, p.lugar, p.tipo, p.nota].join(' ').toLowerCase()}>
                <h3 class="font-semibold leading-snug">{p.t}</h3>
                <p class="mt-0.5 text-[#979797]">
                  {p.hdad} · <a class="underline hover:text-white" href={maps(p.lugar)} target="_blank" rel="noopener">{p.lugar}</a>
                </p>
                {p.nota && <p class="mt-1 text-sm">{p.nota}</p>}
                {p.cartel && (
                  <a href={p.cartel.src} target="_blank" rel="noopener" class="mt-3 block max-w-xs" aria-label={`Ver cartel completo: ${p.t}`}>
                    <Image src={p.cartel} alt={`Cartel: ${p.t}`} width={480} class="w-full rounded-lg border border-[#404040]" />
                  </a>
                )}
              </div>
            ))}
          </div>
        )}

        <ol class="mt-2">
          {delDia.map((a) => (
            <li class="ev grid grid-cols-[64px_minmax(0,1fr)] gap-3 border-b border-[#404040] py-4" data-h={a.h} data-text={[a.t, a.hdad, a.lugar, a.tipo, a.nota].join(' ').toLowerCase()}>
              <time datetime={`${a.d}T${a.h}`} class="whitespace-nowrap text-2xl font-bold leading-none text-[rgb(224,204,250)]">{a.h}</time>
              <div>
                <h3 class="text-lg font-semibold leading-snug">
                  {a.t}
                  <span class="badge ml-2 whitespace-nowrap text-sm font-semibold text-[rgb(136,58,234)]"></span>
                </h3>
                <p class="mt-0.5 text-[#979797]">
                  {a.hdad} · <a class="underline hover:text-white" href={maps(a.lugar)} target="_blank" rel="noopener">{a.lugar}</a>
                </p>
                {a.nota && <p class="mt-1 text-sm">{a.nota}</p>}
                {a.cartel && (
                  <a href={a.cartel.src} target="_blank" rel="noopener" class="mt-3 block max-w-xs" aria-label={`Ver cartel completo: ${a.t}`}>
                    <Image src={a.cartel} alt={`Cartel: ${a.t}`} width={480} class="w-full rounded-lg border border-[#404040]" />
                  </a>
                )}
                <span class="mt-2 inline-block rounded-full bg-[#404040] px-3 py-0.5 text-xs font-semibold">{a.tipo}</span>
              </div>
            </li>
          ))}
        </ol>
        <p class="empty hidden py-10 text-center text-[#979797]">No hay actos que coincidan con la búsqueda.</p>
      </section>
    );
  })}

  <p class="mt-8 text-sm text-[#979797]">
    Recopilado de los carteles oficiales de cada hermandad. ¿Ves un error? Escríbenos por Instagram.
  </p>
</main>

<style>
  .tab[aria-selected='true'] { background: rgb(136, 58, 234); border-color: rgb(136, 58, 234); }
  .ev.now { background: #404040; margin-inline: -0.75rem; padding-inline: 0.75rem; border-radius: 0.75rem; border-color: transparent; }
  .ev.past { opacity: 0.45; }
  .copy.ok { background: rgb(136, 58, 234); color: white; }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tab')];
  const days = [...document.querySelectorAll<HTMLElement>('.day')];
  const q = document.querySelector<HTMLInputElement>('#q')!;

  const now = new Date();
  const hoy = now.toLocaleDateString('sv-SE', { timeZone: 'Europe/Madrid' }); // AAAA-MM-DD
  const [hh, mm] = now.toLocaleTimeString('es-ES', { timeZone: 'Europe/Madrid', hour12: false }).split(':').map(Number);
  const nowMin = hh * 60 + mm;
  const toMin = (h: string) => { const [a, b] = h.split(':').map(Number); return a * 60 + b; };

  function show(day: string) {
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.day === day)));
    days.forEach((s) => (s.hidden = s.dataset.day !== day));
  }

  function filter() {
    const term = q.value.trim().toLowerCase();
    days.forEach((s) => {
      let visibles = 0;
      s.querySelectorAll<HTMLElement>('li.ev').forEach((li) => {
        const ok = !term || (li.dataset.text ?? '').includes(term);
        li.classList.toggle('hidden', !ok);
        if (ok) visibles++;
      });
      s.querySelector('.empty')?.classList.toggle('hidden', visibles > 0);
    });
  }

  // "En curso" / "Próximo" y atenuar lo ya pasado, solo en el día de hoy
  const sec = days.find((s) => s.dataset.day === hoy);
  if (sec) {
    let marcado = false;
    sec.querySelectorAll<HTMLElement>('li.ev').forEach((li) => {
      const m = toMin(li.dataset.h ?? '00:00');
      if (m < nowMin - 90) li.classList.add('past');
      else if (!marcado && m >= nowMin - 30) {
        li.classList.add('now');
        li.querySelector('.badge')!.textContent = m <= nowMin ? 'En curso' : 'Próximo';
        marcado = true;
      }
    });
  }

  const ids = tabs.map((t) => t.dataset.day!);
  const inicial = location.hash.slice(1);
  show(ids.includes(inicial) ? inicial : ids.includes(hoy) ? hoy : ids[0]);

  tabs.forEach((t) => t.addEventListener('click', () => { show(t.dataset.day!); history.replaceState(null, '', '#' + t.dataset.day); }));
  q.addEventListener('input', filter);

  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) =>
    b.addEventListener('click', async () => {
      const txt = b.dataset.msg ?? '';
      try { await navigator.clipboard.writeText(txt); }
      catch {
        const ta = document.createElement('textarea'); ta.value = txt; document.body.appendChild(ta); ta.select();
        document.execCommand('copy'); ta.remove();
      }
      const orig = b.textContent;
      b.textContent = 'Copiado'; b.classList.add('ok');
      setTimeout(() => { b.textContent = orig; b.classList.remove('ok'); }, 1800);
    })
  );
</script>
