---
interface Props {
    href: string;
    name: string;
    icon: string;
}
const { href, name, icon } = Astro.props;
---
<a class="flex justify-center items-center mx-2 p-3 size-[72px] rounded-2xl bg-[#404040]" target="_blank" href={href} title={name}>
    <img class="size-8" src=`./socialsIcons/${icon}` alt={name}/>
</a>
